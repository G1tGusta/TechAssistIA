# Serviço do Linux (systemd) para o TechAssist AI.
# Instalação (ajuste o caminho e o usuário abaixo):
#   sudo cp servidor/techassist.service /etc/systemd/system/techassist.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now techassist
#   sudo systemctl status techassist        (logs: journalctl -u techassist -f)
[Unit]
Description=TechAssist AI (autoatendimento de TI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=techassist
WorkingDirectory=/opt/techassist
Environment=TZ=America/Sao_Paulo
ExecStart=/opt/techassist/.venv/bin/python -m streamlit run app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
