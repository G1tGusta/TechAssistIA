# HTTPS com o Nginx (proxy reverso). O Streamlit usa WebSocket: os cabeçalhos Upgrade são obrigatórios.
server {
    listen 443 ssl;
    server_name chamados.suaempresa.local;

    ssl_certificate     /etc/ssl/certs/techassist.crt;
    ssl_certificate_key /etc/ssl/private/techassist.key;

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }
}
